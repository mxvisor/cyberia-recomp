; The extern.llinc of Cyberia: the default extern.llinc of a DOS4GW game (what
; the DOS runtime defines) and the symbols the port itself provides.
;
; A game that replaces library routines or adds its own host functions has
; its own game/llasm/extern.llinc (it replaces the default one) and includes
; dos.llinc.

; called by every ACTION_* macro (macros.llinc): Game_dostimer.c
funcv SR_CheckTimer

include dos.llinc

; The environment of the program as the C library reads it: the array of the
; addresses of the variables ("NAME=VALUE"), with a zero at the end.  The
; getenv of the extender (4GW) read its own copy of the array
; (instruction_replacements.sci reads this one instead), and its copy was
; built by the server of the extender, which is not in the port: the runtime
; builds it (game/Game_environ.c).
extern cyb_environ
